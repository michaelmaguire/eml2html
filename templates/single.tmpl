{{define "page"}}<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        {{if .CSP}}<meta http-equiv="Content-Security-Policy" content="{{.CSP}}">{{end}}
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{.Subject}}</title>
        <style>
:root {
    --fg: #1f2328;
    --muted: #59636e;
    --line: #d1d9e0;
    --bg: #ffffff;
    --panel: #f6f8fa;
    color-scheme: light dark;
}
@media (prefers-color-scheme: dark) {
    :root {
        --fg: #e6edf3;
        --muted: #9198a1;
        --line: #3d444d;
        --bg: #0d1117;
        --panel: #151b23;
    }
}
body {
    margin: 0;
    padding: 12px;
    background: var(--bg);
    color: var(--fg);
    font: 14px/1.5 system-ui, -apple-system, "Segoe UI", sans-serif;
}
.message {
    border: 1px solid var(--line);
    border-radius: 6px;
    overflow: hidden;
}
.headers {
    margin: 0;
    padding: 10px 12px;
    background: var(--panel);
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 2px 12px;
}
.headers dt {
    color: var(--muted);
}
.headers dd {
    margin: 0;
    overflow-wrap: anywhere;
}
.subject {
    font-weight: 600;
}
.body {
    border-top: 1px solid var(--line);
}
iframe.html {
    display: block;
    width: 100%;
    height: 40em;
    border: 0;
    resize: vertical;
    background: #ffffff;
}
pre.text {
    margin: 0;
    padding: 12px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
}
.attachments {
    border-top: 1px solid var(--line);
    padding: 10px 12px;
}
.attachments ul {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
}
.attachments li {
    margin: 4px 0;
}
.attachments .meta {
    color: var(--muted);
}
.attachments img {
    display: block;
    max-width: 100%;
    max-height: 30em;
    margin: 4px 0;
}
details {
    margin: 6px 0;
}
.empty {
    padding: 12px;
    color: var(--muted);
}
        </style>
    </head>
    <body>
        {{template "message" .}}
    </body>
</html>
{{end}}

{{define "message"}}
<div class="message">
    <dl class="headers">
        <dt>Subject</dt><dd class="subject">{{.Subject}}</dd>
        {{if .Date}}<dt>Date</dt><dd>{{.Date}}</dd>{{end}}
        {{if .From}}<dt>From</dt><dd>{{.From}}</dd>{{end}}
        {{if .To}}<dt>To</dt><dd>{{.To}}</dd>{{end}}
        {{if .CC}}<dt>CC</dt><dd>{{.CC}}</dd>{{end}}
    </dl>
    <div class="body">
        {{range .Bodies}}{{.}}{{else}}<div class="empty">No content found</div>{{end}}
    </div>
    {{if .Attachments}}
    <div class="attachments">
        <strong>Attachments</strong>
        <ul>
            {{range .Attachments}}
            <li>
                {{.Name}} <span class="meta">({{.Type}}, {{.Size}})</span>
                {{if .ImageURL}}<img src="{{.ImageURL}}" alt="{{.Name}}">{{end}}
                {{if .Message}}{{if .Open}}<details open>{{else}}<details>{{end}}<summary>Show attached message</summary>{{.Message}}</details>{{end}}
            </li>
            {{end}}
        </ul>
    </div>
    {{end}}
</div>
{{end}}
